{
  "name": "gestobar",
  "private": true,
  "packageManager": "pnpm@8.12.0",
"scripts": {
    "dev": "pnpm run /^dev:/",
    "dev:frontend": "pnpm -F gestobar-frontend dev",
    "dev:backend": "pnpm -F gestobar-backend dev",
    "build:frontend": "pnpm -F gestobar-frontend build",
    "preview:frontend": "pnpm -F gestobar-frontend preview",
    "build:backend": "pnpm -F gestobar-backend build",
    "start:backend": "pnpm -F gestobar-backend start"
  }
}
