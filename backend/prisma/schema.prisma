generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SuperAdmin
  BusinessOwner
  Employee
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  PENDING_PAYMENT
}

// Order status tracks the lifecycle of a customer order.
enum OrderStatus {
  OPEN
  PREPARING
  READY
  DELIVERED
  PAID
  CANCELLED
}

// Order type separates table, takeaway and delivery orders.
enum OrderType {
  TABLE
  TAKEAWAY
  DELIVERY
}

enum CashEntryType {
  OPENING
  CLOSING
  SALE
  EXPENSE
  ADJUSTMENT
}

model Business {
  id              String           @id @default(uuid())
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  categories      Category[]
  menuItems       MenuItem[]
  inventory       InventoryItem[]
  tables          Table[]
  orders          Order[]
  cashEntries     CashEntry[]
  salonLayout     SalonLayout?
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  role            UserRole         @default(Employee)
  isActive        Boolean          @default(true)
  business        Business         @relation(fields: [businessId], references: [id])
  businessId      String
  orders          Order[]          @relation("WaiterOrders")
  cashEntries     CashEntry[]
  userPermissions UserPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Category {
  id         String          @id @default(uuid())
  name       String
  type       String          @default("MENU") // "MENU" or "INVENTORY"
  business   Business        @relation(fields: [businessId], references: [id])
  businessId String
  menuItems  MenuItem[]
  inventory  InventoryItem[]
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model InventoryItem {
  id         String    @id @default(uuid())
  name       String
  unit       String    @default("un") // unit of measurement (kg, l, un)
  cost       Float     @default(0)
  stock      Float     @default(0)
  isActive   Boolean   @default(true)
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
  business   Business  @relation(fields: [businessId], references: [id])
  businessId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Float
  isActive    Boolean     @default(true)
  category    Category?   @relation(fields: [categoryId], references: [id])
  categoryId  String?
  business    Business    @relation(fields: [businessId], references: [id])
  businessId  String
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Table {
  id            String      @id @default(uuid())
  name          String
  capacity      Int         @default(4)
  status        TableStatus @default(FREE)
  linkedTableId String?
  linkedTable   Table?      @relation("LinkedTables", fields: [linkedTableId], references: [id])
  linkedBy      Table[]     @relation("LinkedTables")
  business      Business    @relation(fields: [businessId], references: [id])
  businessId    String
  orders        Order[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  type            OrderType   @default(TABLE)
  status          OrderStatus @default(OPEN)
  total           Float       @default(0)
  // tableId is optional: null for TAKEAWAY and DELIVERY orders.
  table           Table?      @relation(fields: [tableId], references: [id])
  tableId         String?
  deliveryAddress String?
  waiter          User        @relation("WaiterOrders", fields: [waiterId], references: [id])
  waiterId        String
  business        Business    @relation(fields: [businessId], references: [id])
  businessId      String
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  product   MenuItem @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
  notes     String?
}

model CashEntry {
  id         String        @id @default(uuid())
  amount     Float
  type       CashEntryType
  note       String?
  business   Business      @relation(fields: [businessId], references: [id])
  businessId String
  user       User          @relation(fields: [userId], references: [id])
  userId     String
  orderId    String?
  createdAt  DateTime      @default(now())
}

model SalonLayout {
  id         String   @id @default(uuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String   @unique
  rows       Int
  columns    Int
  areas      Area[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Area {
  id            String      @id @default(uuid())
  name          String
  color         String
  cells         Json
  salonLayout   SalonLayout @relation(fields: [salonLayoutId], references: [id], onDelete: Cascade)
  salonLayoutId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// Permission keys define specific capabilities (e.g. 'orders:create').
model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String?
  roles           RolePermission[]
  userPermissions UserPermission[]
}

// RolePermission assigns permissions globally to a role within a business.
model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String
  business     Business   @relation(fields: [businessId], references: [id])
  businessId   String

  @@unique([role, permissionId, businessId])
}

// UserPermission allows BusinessOwner to grant specific permissions to individual employees.
model UserPermission {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String
  business     Business   @relation(fields: [businessId], references: [id])
  businessId   String

  @@unique([userId, permissionId])
}